# Multi-stage release build for isityael/nfsplugin.
# Cross-compilation: builder runs on BUILDPLATFORM (native speed),
# Go cross-compiles to TARGETARCH. Only the runtime stage uses QEMU.
ARG GO_VERSION=1.26.5@sha256:3aff6657219a4d9c14e27fb1d8976c49c29fddb70ba835014f477e1c70636647

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG IMAGE_VERSION=dev
ARG GIT_COMMIT=unknown

WORKDIR /src
COPY go.mod go.sum ./
COPY vendor/ vendor/
COPY cmd/ cmd/
COPY pkg/ pkg/

RUN BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -a \
    -ldflags "-s -w -extldflags '-static' \
    -X github.com/isityael/csi-driver-nfs/pkg/nfs.driverVersion=${IMAGE_VERSION} \
    -X github.com/isityael/csi-driver-nfs/pkg/nfs.gitCommit=${GIT_COMMIT} \
    -X github.com/isityael/csi-driver-nfs/pkg/nfs.buildDate=${BUILD_DATE}" \
    -mod vendor -o /nfsplugin ./cmd/nfsplugin

FROM dhi.io/debian-base:trixie-debian13-dev@sha256:9d293dad5b7b448154d2fee38651d7cd6faa4953300d84503bfacca22357a879
COPY --from=builder /nfsplugin /nfsplugin
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates mount netbase nfs-common && \
    rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["/nfsplugin"]
